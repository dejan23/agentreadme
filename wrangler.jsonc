{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentreadme",
  "main": "src/index.ts",
  "account_id": "a3687f54c4b2d94aecdb0b15c821b842",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Open Graph cards. Rasterising a PNG costs far more CPU than the free plan
  // allows per request, so they are pre-rendered and served as static files.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentreadme",
      "database_id": "6841336b-251e-405c-a9d8-58ec87ac2f56",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "agentreadme.com", "custom_domain": true },
    { "pattern": "www.agentreadme.com", "custom_domain": true }
  ]
}
