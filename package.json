{
  "name": "agentreadme",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src scripts",
    "format": "biome check --write src scripts",
    "build:cli": "esbuild src/local/cli.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "cli": "bun run src/local/cli.ts"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.3.0",
    "esbuild": "^0.28.2",
    "satori": "^0.33.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=24"
  },
  "version": "0.1.0",
  "description": "How well can an AI coding agent work in this repo? Runs locally, nothing uploaded.",
  "license": "MIT",
  "homepage": "https://agentreadme.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dejan23/agentreadme.git"
  },
  "keywords": [
    "agents-md",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "developer-tools",
    "cli"
  ],
  "bin": {
    "agentreadme": "./dist/cli.js"
  },
  "files": [
    "dist"
  ]
}
